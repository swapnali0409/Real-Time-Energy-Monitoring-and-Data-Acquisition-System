/* -------------------------------------------------------------------------- */
/* ADC CALLBACK                                                              */
/* -------------------------------------------------------------------------- */

void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef* hadc)
{
    if(hadc->Instance == ADC1)
    {
        /* Convert raw ADC value to sensor voltage */

        float v_raw =
            (adc_buffer[0] * 3.3f) / 4095.0f;

        float i_raw =
            (adc_buffer[1] * 3.3f) / 4095.0f;


        /* Apply sensor calibration */

        voltage = v_raw * 5.0f;

        current = (i_raw - 2.5f) * 10.0f;


        /* Calculate power */

        power = voltage * current;


        /* Over-voltage / over-current indication */

        if((voltage > 10.0f) || (current > 2.0f))
        {
            HAL_GPIO_WritePin(
                GPIOA,
                GPIO_PIN_5,
                GPIO_PIN_SET
            );
        }
        else
        {
            HAL_GPIO_WritePin(
                GPIOA,
                GPIO_PIN_5,
                GPIO_PIN_RESET
            );
        }
    }
}


/* -------------------------------------------------------------------------- */
/* MAIN FUNCTION                                                             */
/* -------------------------------------------------------------------------- */

int main(void)
{
    /* Reset peripherals, initialize Flash interface
       and Systick */

    HAL_Init();


    /* Configure system clock */

    SystemClock_Config();


    /* Initialize peripherals */

    MX_GPIO_Init();

    MX_DMA_Init();

    MX_ADC1_Init();

    MX_USART2_UART_Init();


    /* Initialize LCD */

    lcd_initialise();


    /* Start ADC with DMA */

    HAL_ADC_Start_DMA(
        &hadc1,
        (uint32_t*)adc_buffer,
        CHANNELS
    );


    /* Infinite loop */

    while(1)
    {
        /* -------------------------------------------------------------- */
        /* LCD DISPLAY                                                    */
        /* -------------------------------------------------------------- */

        lcd_command(0x80);

        sprintf(
            msg,
            "V:%.1fV I:%.1fA",
            voltage,
            current
        );

        lcd_string(
            msg,
            strlen(msg)
        );


        lcd_command(0xC0);

        sprintf(
            msg,
            "P:%.2f Watt",
            power
        );

        lcd_string(
            msg,
            strlen(msg)
        );


        /* -------------------------------------------------------------- */
        /* UART DATA LOGGING                                              */
        /* -------------------------------------------------------------- */

        sprintf(
            uart_msg,
            "LOG: V=%.2f, I=%.2f, P=%.2f\r\n",
            voltage,
            current,
            power
        );

        HAL_UART_Transmit(
            &huart2,
            (uint8_t*)uart_msg,
            strlen(uart_msg),
            100
        );


        /* -------------------------------------------------------------- */
        /* DISPLAY REFRESH DELAY                                         */
        /* -------------------------------------------------------------- */

        HAL_Delay(300);
    }
}


